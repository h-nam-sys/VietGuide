# Add only the settings you need to your existing .env; do not replace it.
APP_ENV=production
# Existing ADMIN_PASSWORD must remain configured.
# Public HTTPS only (keep auto for localhost HTTP):
# SESSION_COOKIE_SECURE=1
# PUBLIC_HOST=chat.example.org
# Optional: supervise Caddy with the existing launcher:
# CADDY_BINARY=C:/tools/caddy/caddy.exe
GPU_SERVICE_TIMEOUT=300
INGEST_EMBED_BATCH=4
SERVICE_RESTART_LIMIT=3
SERVICE_STARTUP_GRACE=300
