# Reuse the already-built runtime; this update does not compile inference again.
ARG HYBRID_BASE_IMAGE=namnhedu/legal_llm-chat-service:hybrid-v1
FROM ${HYBRID_BASE_IMAGE}
WORKDIR /app
COPY backend ./backend
COPY rag ./rag
COPY run_services.py qa_suite.py ./
COPY deployment/manage.py ./deployment/manage.py
COPY deployment/container ./deployment/container
